DATABASE_URL="postgresql://checkin:checkin@localhost:5432/checkin"
# Optional: derived from DATABASE_URL when empty. Random 32+ chars. Signs admin session cookie.
SESSION_SECRET="change-me-to-a-long-random-string-123456"
# Optional: derived from DATABASE_URL when empty. 32 bytes base64, encrypts customer-API credentials. `openssl rand -base64 32`
DATA_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Default: cbn when CBN_AUTH_VERIFY_URL is set, otherwise mock (demo: token = customer_id, red badge in admin).
APP_AUTH_MODE="mock"
# Allows mock mode on a production deploy (demo only). Admin shows a red badge while on. Remove before launch.
ALLOW_DEMO_TOKEN=""
CBN_AUTH_VERIFY_URL=""
# Label in admin header
APP_ENV_LABEL="Development"
# Seeded first admin
SEED_ADMIN_EMAIL="admin@cbn.id"
SEED_ADMIN_PASSWORD="ganti-password-ini"
